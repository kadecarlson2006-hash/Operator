# Operator BACKEND environment (Milestone 4+). Copy to .env — git-ignored. Never commit secrets.
# The Android app does not read this file. Real environment variables override the file.

# Server
OPERATOR_BACKEND_PORT=8080
OPERATOR_BACKEND_HOST=0.0.0.0

# Memory database (Milestone 5). Matches backend/docker-compose.yml.
# Accepts postgresql://user:pass@host:port/db or jdbc:postgresql://host:port/db (+ DATABASE_USER/PASSWORD)
DATABASE_URL=postgresql://operator:operator@localhost:5432/operator

# Provider credentials (backend-only; Milestones 6 / 8 / 9)
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
# Speech-to-text. May be a different vendor from the model provider.
TRANSCRIPTION_API_KEY=

# Model routing (never hard-coded)
OPERATOR_FAST_MODEL_ID=
OPERATOR_DEEP_MODEL_ID=
# Decides whether Operator speaks at all (Milestone 12). Empty falls back to the fast model.
OPERATOR_DECISION_MODEL_ID=
OPERATOR_VISION_MODEL_ID=
# Embedding model for semantic memory retrieval (Milestone 7). Leave empty for lexical retrieval.
OPERATOR_EMBEDDING_MODEL_ID=

# Hearing (Milestone 8). Any endpoint that speaks the OpenAI-compatible
# /audio/transcriptions shape, including a self-hosted Whisper server.
OPERATOR_TRANSCRIPTION_PROVIDER=
OPERATOR_TRANSCRIPTION_MODEL_ID=
# Leave empty for the vendor default (https://api.openai.com/v1).
OPERATOR_TRANSCRIPTION_BASE_URL=
# Optional language hint, e.g. en. Empty lets the model detect it.
OPERATOR_TRANSCRIPTION_LANGUAGE=

# Voice
OPERATOR_TTS_PROVIDER=elevenlabs
OPERATOR_ELEVENLABS_VOICE_ID=
OPERATOR_ELEVENLABS_MODEL_ID=

# Allow POST /memory/demo-seed (fictional demo memories). Keep false outside development.
OPERATOR_DEMO_SEED_ENABLED=true

# Personality prompt version (file under operator-prompts/system/)
OPERATOR_PROMPT_VERSION=operator-system-v1

# Behaviour
OPERATOR_DEFAULT_MODE=STANDBY
OPERATOR_DEFAULT_WIT=NORMAL
ROLLING_CONTEXT_SECONDS=60
MIN_COMMENT_INTERVAL_SECONDS=45
MAX_COMMENTS_PER_5_MINUTES=3
# Milestone 13: how often Operator may *ask* whether to speak. These are the only limits that
# hold while it stays silent, which is the common case, so they are what bounds spending.
MIN_DECISION_INTERVAL_SECONDS=20
MAX_DECISIONS_PER_5_MINUTES=12
